# SecureSight360 backend production environment example
# Copy these keys into your deployment provider environment settings.
# Do NOT commit real production secrets.
# Do NOT paste real secrets into chat.

APP_ENV=production
LOG_LEVEL=INFO
DEBUG=false

# Required. Generate a strong unique secret inside your deployment provider.
SECURESIGHT360_AUTH_SECRET_KEY=replace-with-strong-production-secret

# Optional initial admin seed values.
# Use a strong temporary password, then change it after first login.
SECURESIGHT360_ADMIN_EMAIL=admin@securesight360.com
SECURESIGHT360_ADMIN_PASSWORD=replace-with-strong-temporary-admin-password

# Production frontend/API origins.
# Keep the Vercel temporary domain until the custom domain is fully connected.
CORS_ORIGINS=["https://securesight360.com","https://www.securesight360.com","https://securesight360.vercel.app","https://api.securesight360.com"]

# Production database.
# Use Neon PostgreSQL Free for MVP production.
# Use the pooled Neon connection string if Neon provides one.
# Example format only; never commit real credentials:
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Local development uses SQLite in backend/.env, not this production file:
# DATABASE_URL=sqlite:///./data/cybershield360.db
