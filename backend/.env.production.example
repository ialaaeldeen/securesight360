# SecureSight360 backend production environment example
# Copy these keys into your deployment provider environment settings.
# Do NOT commit real production secrets.

APP_ENV=production
LOG_LEVEL=INFO

# Required. Generate a strong unique secret in your deployment provider.
SECURESIGHT360_AUTH_SECRET_KEY=replace-with-strong-production-secret

# Optional initial admin seed values.
# Prefer setting these only when seeding/admin setup is needed.
SECURESIGHT360_ADMIN_EMAIL=admin@securesight360.com
SECURESIGHT360_ADMIN_PASSWORD=replace-with-strong-temporary-admin-password

# Production frontend/API origins.
CORS_ORIGINS=["https://securesight360.com","https://www.securesight360.com","https://api.securesight360.com"]

# Current local/default DB.
# For real production users, migrate to PostgreSQL later.
DATABASE_URL=sqlite:///./data/cybershield360.db

# Future PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DBNAME
